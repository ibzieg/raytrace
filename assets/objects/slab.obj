# created in emacs!!
# 2011-04-23

mtllib monkey_head.mtl

v -7.0 -5.0 0
v  7.0 -5.0 0
v  7.0  5.0 0
v -7.0  5.0 0

v -7.0 -5.0 -2.0
v  7.0 -5.0 -2.0
v  7.0  5.0 -2.0
v -7.0  5.0 -2.0

vn  0.0  0.0 1.0
vn  0.0  0.0 -1.0
vn  0.0  1.0  0.0
vn  0.0 -1.0  0.0
vn  1.0  0.0  0.0
vn -1.0  0.0  0.0

s 6
g slab6
usemtl headMtl

#FRONT FACE +Z
f 1//1 2//1 3//1
f 1//1 3//1 4//1

s 1
g slab1
usemtl headMtl

#BACK FACE -Z
f 6//2 5//2 7//2
f 8//2 7//2 5//2

s 2
g slab2
usemtl headMtl

#BOTTOM FACE -Y
f 5//4 2//4 1//4
f 5//4 6//4 2//4 

s 3
g slab3
usemtl headMtl

#TOP FACE +Y
f 8//3 4//3 3//3
f 8//3 3//3 7//3

s 4
g slab4
usemtl headMtl

#LEFT FACE -X
f 4//6 5//6 1//6
f 8//6 5//6 4//6

s 5
g slab5
usemtl headMtl

#RIGHT FACE +X
f 6//5 3//5 2//5
f 6//5 7//5 3//5

